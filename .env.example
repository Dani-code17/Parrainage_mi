# =====================================================================
#  Variables d'environnement — modèle
#
#  En local, rien n'est nécessaire : les valeurs par défaut conviennent.
#  En ligne, recopiez ce fichier en « .env » et remplissez les valeurs.
#
#  ⚠️ Le fichier .env ne doit JAMAIS être publié sur GitHub
#     (il est déjà exclu par .gitignore).
# =====================================================================

# --- Indispensable en ligne -----------------------------------------

# Clé secrète : longue chaîne aléatoire, à garder confidentielle.
# Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire

# Mode production : False en ligne (obligatoire).
DJANGO_DEBUG=False

# Domaines autorisés, séparés par des virgules (sans http://).
DJANGO_ALLOWED_HOSTS=parrainage.mon-ecole.ci,www.parrainage.mon-ecole.ci

# Origines de confiance pour les formulaires (avec https://).
DJANGO_CSRF_TRUSTED_ORIGINS=https://parrainage.mon-ecole.ci

# --- Base de données -------------------------------------------------

# PostgreSQL. Le format est :
#   postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# Exemple Oracle Cloud / serveur de l'école :
#   postgres://parrainage:motdepasse@localhost:5432/parrainage
# Si laissé vide, SQLite est utilisé (déconseillé en ligne).
DATABASE_URL=

# --- Divers ----------------------------------------------------------

# Rediriger automatiquement vers https (laisser vide en local).
DJANGO_SSL_REDIRECT=1
